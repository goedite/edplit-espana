{
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/tienda.html",        "destination": "https://tienda.edplit.es", "permanent": true },
    { "source": "/tienda",             "destination": "https://tienda.edplit.es", "permanent": true },
    { "source": "/tienda-global.html", "destination": "https://tienda.edplit.es", "permanent": true },
    { "source": "/tienda-global",      "destination": "https://tienda.edplit.es", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
